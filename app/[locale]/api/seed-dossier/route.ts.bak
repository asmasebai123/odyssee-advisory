import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const email = searchParams.get("email");

  if (!email) {
    return NextResponse.json({
      success: false,
      error: "Veuillez fournir un paramètre email. Exemple : ?email=client@odyssee.com"
    }, { status: 400 });
  }

  const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
  const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY!;

  if (!supabaseUrl || !supabaseServiceKey) {
    return NextResponse.json({
      success: false,
      error: "Supabase keys missing in .env.local"
    }, { status: 500 });
  }

  const supabase = createClient(supabaseUrl, supabaseServiceKey);

  try {
    // 1. Récupérer l'utilisateur correspondant dans la table public.users
    const { data: user, error: userError } = await supabase
      .from('users')
      .select('*')
      .eq('email', email.trim())
      .maybeSingle();

    if (userError) throw new Error("Database query error: " + userError.message);
    if (!user) {
      return NextResponse.json({
        success: false,
        error: `L'utilisateur avec l'email "${email}" n'a pas été trouvé dans la table public.users. Veuillez d'abord créer ce compte sur la page d'inscription de votre site.`
      }, { status: 404 });
    }

    // 2. Nettoyer les anciens dossiers pour ce client
    await supabase.from('dossiers').delete().eq('client_id', user.id);

    // 3. Créer le dossier Emaar Beachfront Palace
    const { data: dossierData, error: dosError } = await supabase
      .from('dossiers')
      .insert({
        client_id: user.id,
        titre: "Emaar Beachfront Palace — Apt. 4204",
        type_service: "Acquisition Immobilière - Dubaï",
        montant: 3420000,
        statut: "en_cours",
      })
      .select()
      .single();

    if (dosError) throw new Error("Dossier insertion error: " + dosError.message);

    // 4. Insérer les documents de test associés
    await supabase.from('documents').delete().eq('dossier_id', dossierData.id);
    const { error: docError } = await supabase.from('documents').insert([
      {
        dossier_id: dossierData.id,
        nom: "Compromis de vente signé.pdf",
        url: "https://qecoamfqucciqmwqxwlw.supabase.co/storage/v1/object/public/documents/sample.pdf",
        signe: true,
        type: "contrat"
      },
      {
        dossier_id: dossierData.id,
        nom: "Formulaire d'enregistrement foncier.pdf",
        url: "https://qecoamfqucciqmwqxwlw.supabase.co/storage/v1/object/public/documents/sample.pdf",
        signe: false,
        type: "autre"
      },
      {
        dossier_id: dossierData.id,
        nom: "Passeport certifié conforme.pdf",
        url: "https://qecoamfqucciqmwqxwlw.supabase.co/storage/v1/object/public/documents/sample.pdf",
        signe: true,
        type: "juridique"
      }
    ]);
    if (docError) throw new Error("Documents insertion error: " + docError.message);

    // 5. Insérer les factures associées
    await supabase.from('factures').delete().eq('dossier_id', dossierData.id);
    const { error: facError } = await supabase.from('factures').insert([
      {
        dossier_id: dossierData.id,
        reference: "INV-2026-001",
        libelle: "Frais d'ouverture de dossier cabinet",
        montant: 1250,
        statut: "payee",
        date_emission: "2026-05-01",
        date_echeance: "2026-05-15"
      },
      {
        dossier_id: dossierData.id,
        reference: "INV-2026-002",
        libelle: "Honoraires de conseil — Audit & Due Diligence",
        montant: 2800,
        statut: "en_attente",
        date_emission: "2026-05-10",
        date_echeance: "2026-05-25"
      },
      {
        dossier_id: dossierData.id,
        reference: "INV-2026-003",
        libelle: "Acompte Emaar Beachfront - 10%",
        montant: 342000,
        statut: "payee",
        date_emission: "2026-05-12",
        date_echeance: "2026-05-19"
      }
    ]);
    if (facError) throw new Error("Factures insertion error: " + facError.message);

    // 6. Insérer l'historique des échanges
    await supabase.from('messages').delete().eq('dossier_id', dossierData.id);
    const { error: msgError } = await supabase.from('messages').insert([
      {
        dossier_id: dossierData.id,
        auteur_id: user.id, // Client
        contenu: "Bonjour Maître Debuisson, j'ai bien complété mon profil d'acquisition. Pouvons-nous valider la due diligence ?",
        lu: true
      },
      {
        dossier_id: dossierData.id,
        auteur_id: dossierData.id, // Autre ID (Simule l'avocat)
        contenu: "Bonjour, j'ai bien initié votre dossier pour l'appartement 4204 à Emaar Beachfront. J'analyse vos pièces et reviens vers vous !",
        lu: false
      }
    ]);

    return NextResponse.json({
      success: true,
      message: `Félicitations ! Le dossier premium Emaar Beachfront a été rattaché avec succès au compte "${email}". Vous pouvez maintenant vous connecter et explorer votre espace privé !`
    });

  } catch (err: any) {
    return NextResponse.json({
      success: false,
      error: err.message
    }, { status: 500 });
  }
}
